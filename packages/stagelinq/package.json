{
  "name": "@netbeat/stagelinq",
  "version": "0.0.0",
  "description": "Read-only observer for Denon StageLinQ network traffic.",
  "type": "module",
  "license": "MIT",
  "author": "Cameron Tacklind <cameron@tacklind.com>",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "dependencies": {
    "@netbeat/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "denon",
    "stagelinq",
    "engine-dj",
    "prime",
    "sc6000",
    "sc5000",
    "dj",
    "network",
    "observer"
  ]
}
